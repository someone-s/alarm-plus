<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        android:purposeString="@string/manifest_permission_receivebootcomplete_purpose"/>
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        android:purposeString="@string/manifest_permission_exactalarm_purpose"
        tools:ignore="ExactAlarmPolicy" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:purposeString="@string/manifest_permission_exactalarm_purpose"
        android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:purposeString="@string/manifest_permission_postnotifications_purpose"/>
    <uses-permission
        android:name="android.permission.VIBRATE"
        android:purposeString="@string/manifest_permission_vibrate_purpose"/>
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        android:purposeString="@string/manifest_permission_usefullscreenintent_purpose"
        tools:ignore="FullScreenIntentPolicy" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        android:purposeString="@string/manifest_permission_foregroundservice_purpose"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED"
        android:purposeString="@string/manifest_permission_foregroundservicesystemexempted_purpose" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        android:purposeString="@string/manifest_permission_foregroundservicemediaplayback_purpose" />
    
    <attribution
        android:tag="playAudibleAlarms"
        android:label="@string/manifest_attribution_playaudiblealarms" />

    <application
        android:name=".AlarmPlusApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icon_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlarmPlus">
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AlarmPlus"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.notification.NotificationActivity"
            android:exported="false"
            android:theme="@style/Theme.AlarmPlus"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            tools:targetApi="27" />
        <service
            android:name=".alert.AlertService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />
        <receiver
            android:name=".logic.access.InitializeReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".logic.access.DismissReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".logic.internal.SystemReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name=".logic.internal.WakeReceiver"
            android:enabled="true"
            android:exported="false" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>